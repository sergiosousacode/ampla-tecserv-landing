generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATIONAL
  CLIENT
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum BillingType {
  MONTHLY
  ONE_OFF
  PROJECT
}

enum ServiceStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  ARCHIVED
}

enum PdfStatus {
  PENDING
  READY
}

enum SharingChannel {
  EMAIL
  WHATSAPP
  PORTAL
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(ADMIN)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  contracts    Contract[]  @relation("CreatedContracts")
}

model Client {
  id           String      @id @default(cuid())
  companyName  String
  document     String?
  contactName  String?
  email        String?
  phone        String?
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  contracts    Contract[]
}

model Service {
  id          String         @id @default(cuid())
  name        String
  category    String
  description String
  billingType BillingType
  basePrice   Decimal?       @db.Decimal(10, 2)
  status      ServiceStatus  @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  contracts   Contract[]
}

model Contract {
  id             String          @id @default(cuid())
  title          String
  content        String
  status         ContractStatus  @default(DRAFT)
  pdfStatus      PdfStatus       @default(PENDING)
  sharingChannel SharingChannel  @default(PORTAL)
  pdfUrl         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  clientId       String
  serviceId      String
  createdById    String

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("CreatedContracts", fields: [createdById], references: [id], onDelete: Restrict)
}
